# Documentation template only. Use `clikvm init-env` to generate unique tokens.
# Example shape after generation: {"cores3-01":"unique-random-device-token"}
# Empty defaults intentionally authorize nobody.
CLIK_DEVICE_TOKENS_JSON='{}'
CLIK_OPERATOR_TOKEN=''
# Network voice controllers have distinct credentials and fixed target bindings.
# Generate with: clikvm init-env --device office-pc --controller m5-01
CLIK_CONTROLLER_TOKENS_JSON='{}'
CLIK_CONTROLLER_TARGETS_JSON='{}'
CLIK_TARGET_ONLINE_SECONDS=30
CLIK_STATE_DIR='.state/gateway'
CLIK_ALLOW_SIMULATION=0
CLIK_REQUIRE_ACTION_CONFIRMATION=0
CLIK_MAX_FRAME_BYTES=4194304
CLIK_MAX_AUDIO_BYTES=4194304
CLIK_MAX_STORAGE_BYTES=268435456
CLIK_FRAMES_PER_SESSION=8
CLIK_LEASE_SECONDS=60
CLIK_ACTION_TTL_SECONDS=120
CLIK_SESSION_TTL_SECONDS=86400
CLIK_MAX_ACTIONS_PER_INTENT=12
CLIK_MODEL_TIMEOUT_SECONDS=45

# Full endpoint URL of your vision-capable OpenAI-compatible provider/proxy.
# Leaving it empty intentionally blocks real planning until configured.
CLIK_MODEL_ENDPOINT=''
CLIK_MODEL_NAME=''
CLIK_MODEL_API_KEY=''

# Existing OQLLM POA route helper; independent from the image planner.
CLIK_POA_ENDPOINT='https://api.oqllm.com/v1/poa/'
CLIK_POA_API_KEY=''

# Explicit STT and TTS endpoint contracts: gateway/README.md.
CLIK_STT_ENDPOINT=''
CLIK_STT_MODEL=''
CLIK_STT_API_KEY=''
CLIK_TTS_ENDPOINT=''
CLIK_TTS_MODEL=''
CLIK_TTS_VOICE=''
CLIK_TTS_API_KEY=''
CLIK_ALLOW_HTTP_UPSTREAMS=0

# Used only by compose.yaml / the optional HTTPS profile.
CLIK_PUBLIC_HOST='clikvm.example.com'
CLIK_ACME_EMAIL='operator@example.com'
