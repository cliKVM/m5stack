      "id": "android-adb",
      "title": "Android przez USB ADB",
      "platforms": [
        "android"
      ],
      "implementation": "implemented",
      "transport": "android-adb",
      "observation": "screenshot",
      "control": "keyboard-pointer",
      "autonomous_loop": true,
      "executor": "ESP32-S3 / firmware clikVM",
      "requires": [
        "Debugowanie USB włączone przez właściciela",
        "Zaufanie RSA potwierdzone na telefonie",
        "Port USB OTG i poprawne zasilanie VBUS"
      ],
      "probe": "Enumeracja ADB ff/42/01, autoryzacja i pierwszy PNG przed gotowością",
      "limits": [
        "Chronione okna mogą być puste",
        "Brak omijania PIN i potwierdzenia RSA",
        "HIL zależy od modelu telefonu i wersji Androida"
      ],
      "sources": [
        "https://developer.android.com/tools/adb"
      ],
      "code": [
        "firmware/components/clik_usb",
        "gateway/clikvm/app.py"
      ],
      "physical_validation": "NOT_RUN",
      "support_claim": "source_implemented_not_hardware_certified"
    },
