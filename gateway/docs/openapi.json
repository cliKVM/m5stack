  "components": {
    "schemas": {
      "ActionLease": {
        "properties": {
          "action_id": {
            "type": "string",
            "title": "Action Id"
          },
          "lease_id": {
            "type": "string",
            "title": "Lease Id"
          },
          "based_on_frame": {
            "type": "integer",
            "title": "Based On Frame"
          },
          "valid_for_ms": {
            "type": "integer",
            "maximum": 120000.0,
            "minimum": 0.0,
            "title": "Valid For Ms"
          },
          "command": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Tap"
              },
              {
                "$ref": "#/components/schemas/Swipe"
              },
              {
                "$ref": "#/components/schemas/Key"
              },
              {
                "$ref": "#/components/schemas/Text"
              },
              {
                "$ref": "#/components/schemas/OpenUrl"
              },
              {
                "$ref": "#/components/schemas/Screenshot"
              },
              {
                "$ref": "#/components/schemas/Wait"
              }
            ],
            "title": "Command",
            "discriminator": {
              "propertyName": "type",
              "mapping": {
                "key": "#/components/schemas/Key",
                "open_url": "#/components/schemas/OpenUrl",
                "screenshot": "#/components/schemas/Screenshot",
                "swipe": "#/components/schemas/Swipe",
                "tap": "#/components/schemas/Tap",
                "text": "#/components/schemas/Text",
                "wait": "#/components/schemas/Wait"
              }
            }
          },
          "operation_uri": {
            "type": "string",
            "title": "Operation Uri"
          },
          "after_action": {
            "type": "string",
            "const": "screenshot",
            "title": "After Action"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action_id",
          "lease_id",
          "based_on_frame",
          "valid_for_ms",
          "command",
          "operation_uri",
          "after_action"
        ],
        "title": "ActionLease"
      },
      "ActionResult": {
        "properties": {
          "lease_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Lease Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "succeeded",
              "failed",
              "uncertain"
            ],
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "maxLength": 1000,
            "title": "Detail",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lease_id",
          "status"
        ],
        "title": "ActionResult"
      },
      "Confirmation": {
        "properties": {
          "approve": {
            "type": "boolean",
            "title": "Approve"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "approve"
        ],
        "title": "Confirmation"
      },
      "FrameAccepted": {
        "properties": {
          "frame_id": {
            "type": "integer",
            "title": "Frame Id"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "resource_urn": {
            "type": "string",
            "title": "Resource Urn"
          },
          "planning_intent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planning Intent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "frame_id",
          "width",
          "height",
          "resource_urn",
          "planning_intent"
        ],
        "title": "FrameAccepted"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
